              "id": "AgACAgIAAxkBAAIKfGk6TFVhj1J7aY2SjRtYpY3vX5FbAAIuC2sbbibYSfX6mn9vAAFGugEAAwIAA20AAzYE",
              "caption": "Пример нового Firefox"
