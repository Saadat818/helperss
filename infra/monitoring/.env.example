GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=strong-password
GRAFANA_ROOT_URL=https://DOMAIN/grafana/
GRAFANA_SERVE_FROM_SUB_PATH=true
GRAFANA_HTTP_ADDR=127.0.0.1
GRAFANA_HTTP_PORT=3000

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
NODE_EXPORTER_PORT=9100

# These ports must match real service ports on the host.
HELPER_TARGET=127.0.0.1:5003
MYCHAT_TARGET=127.0.0.1:5004
MYTASK_TARGET=127.0.0.1:5005
SVETOFOR_TARGET=127.0.0.1:5006
BOT_TARGET=127.0.0.1:5010
